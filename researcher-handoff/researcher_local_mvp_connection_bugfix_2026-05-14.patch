+def test_graph_api_create_edge_uses_explicit_ports(tmp_path: Path) -> None:
+    from deepscientist.daemon.api.handlers import ApiHandlers
+
+    quest_root, _ = _setup_quest(tmp_path)
+    app = SimpleNamespace(quest_service=FakeQuestService(quest_root))
+    handlers = ApiHandlers(app)
+    handlers.graph_model_parse("001", {"file_path": "models/tiny_resnet.py", "symbol": "TinyResNet", "framework": "pytorch"})
+
+    nodes = handlers.graph_nodes("001")["nodes"]
+    source = next(n for n in nodes if n["title"] == "conv1")
+    target = next(n for n in nodes if n["title"] == "bn1")
+    source_port_id = next(p["id"] for p in source["ports"] if p["direction"] == "output")
+    target_port_id = next(p["id"] for p in target["ports"] if p["direction"] == "input")
+
+    edge = handlers.graph_edge_create("001", {
+        "source_node_id": source["id"],
+        "target_node_id": target["id"],
+        "source_port_id": source_port_id,
+        "target_port_id": target_port_id,
+        "edge_type": "data_flow",
+    })
+
+    assert edge["ok"] is True
+    assert edge["edge"]["source_port_id"] == source_port_id
+    assert edge["edge"]["target_port_id"] == target_port_id
+
+
